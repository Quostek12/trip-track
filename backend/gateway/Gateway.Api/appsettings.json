{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "NorbertMokrzycki-HashedWithMyName!ThisKeyMustBeAtLeast32CharactersLong",
    "Issuer": "AuthService",
    "Audience": "MicroservicesApi"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Authorization": "Anonymous",
        "Match": {
          "Path": "/auth/{**catchall}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "account-route": {
        "ClusterId": "auth-cluster",
        "Authorization": "AuthenticatedUserPolicy",
        "Match": {
          "Path": "/api/account/{**catchall}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/account"
          }
        ]
      },
      "resources-route": {
        "ClusterId": "resources-cluster",
        "Authorization": "AuthenticatedUserPolicy",
        "Match": {
          "Path": "/api/resources/{**catchall}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/resources"
          }
        ]
      },
      "workers-route": {
        "ClusterId": "workers-cluster",
        "Authorization": "AuthenticatedUserPolicy",
        "Match": {
          "Path": "/api/workers/{**catchall}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/workers"
          }
        ]
      },
      "trips-route": {
        "ClusterId": "trips-cluster",
        "Authorization": "AuthenticatedUserPolicy",
        "Match": {
          "Path": "/api/trips/{**catchall}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/trips"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7000/"
          }
        }
      },
      "resources-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7001/"
          }
        }
      },
      "workers-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7002/"
          }
        }
      },
      "trips-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7003/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}